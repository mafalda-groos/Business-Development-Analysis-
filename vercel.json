{
  "functions": {
    "api/index.py": {
      "includeFiles": "{ingestion.py,scorer.py,report.py,config.json}"
    }
  },
  "rewrites": [
    { "source": "/api/leads",  "destination": "/api/index" },
    { "source": "/api/run",    "destination": "/api/index" },
    { "source": "/api/cron",   "destination": "/api/index" },
    { "source": "/api/health", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron", "schedule": "0 14 * * 1" }
  ]
}
